# PostgreSQL
POSTGRES_DB=deep_rag
POSTGRES_USER=deep_rag
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Application services (enabled with: docker compose --profile application up)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Service-to-service connection strings. Do not use localhost inside containers.
DATABASE_URL=postgresql+psycopg://deep_rag:change-me-before-deploying@postgres:5432/deep_rag
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Model routing. `local` is an offline citation-preserving verifier for development only.
LLM_PROVIDER=local
LLM_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# CLAUDE_API_KEY=
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# RERANKER_PROVIDER=bge_http
# RERANKER_ENDPOINT=http://your-bge-reranker:8000

# Public paper discovery. Both sources work without a key; use a contact address / free key for better service limits.
# CROSSREF_MAILTO=researcher@example.edu
# OPENALEX_API_KEY=
# Optional institution link-resolver connectors. Keep API keys and SSO credentials out of this file.
# INSTITUTION_CONNECTORS_JSON=[{"id":"unimelb","name":"University of Melbourne","catalog_search_url_template":"https://librarysearch.unimelb.edu.au/nde/search?vid=61UMB_INST%3ANDE&query={query}"}]
