# PostgreSQL
POSTGRES_DB=deep_rag
POSTGRES_USER=deep_rag
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Application services (enabled with: docker compose --profile application up)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Service-to-service connection strings. Do not use localhost inside containers.
DATABASE_URL=postgresql+psycopg://deep_rag:change-me-before-deploying@postgres:5432/deep_rag
REDIS_URL=redis://redis:6379/0

# Model routing. `local` is an offline citation-preserving verifier for development only.
LLM_PROVIDER=local
LLM_MODEL=gpt-4.1-mini
